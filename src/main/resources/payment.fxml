<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane stylesheets="@styles.css" prefHeight="590.0" prefWidth="640.0"
            style="-fx-background-color: #F5F4F0;"
            xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.btm495.miyamoto.controllers.PaymentController">
   <children>
      <VBox AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0"
            AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">
         <children>

            <!-- Topbar -->
            <HBox styleClass="topbar" prefHeight="66.0" alignment="CENTER_LEFT">
               <Region styleClass="topbar-accent" prefHeight="66.0"/>
               <VBox style="-fx-padding: 0 0 0 18;">
                  <Label styleClass="topbar-title" text="Payment"/>
                  <Label styleClass="topbar-subtitle" text="Miyamoto Sushi Academy"/>
               </VBox>
            </HBox>

            <!-- Card -->
            <VBox VBox.vgrow="ALWAYS" alignment="CENTER" style="-fx-padding: 20 52 20 52;">
               <children>
                  <VBox styleClass="card" prefWidth="510.0" spacing="0.0" style="-fx-padding: 0;">
                     <children>

                        <!-- Summary band -->
                        <VBox style="-fx-background-color: #EDEAE4; -fx-background-radius: 12 12 0 0;
                                    -fx-padding: 18 24 18 24; -fx-border-color: transparent transparent #E2DDD7 transparent;
                                    -fx-border-width: 0 0 1 0;" spacing="6.0">
                           <Label text="Booking Summary" styleClass="section-title"/>
                           <Label fx:id="bookingSummaryLabel" wrapText="true" prefWidth="460.0"
                                  style="-fx-font-size: 12px; -fx-text-fill: #696865;"/>
                           <Label fx:id="totalAmountLabel" styleClass="price-label"/>
                        </VBox>

                        <VBox spacing="14.0" style="-fx-padding: 22 24 22 24;">
                           <children>
                              <VBox spacing="4.0">
                                 <Label text="Payment Method" styleClass="field-label"/>
                                 <ComboBox fx:id="paymentMethodCombo" prefWidth="320.0"
                                           promptText="Select payment method"/>
                              </VBox>

                              <!-- Card Details (shown/hidden by controller) -->
                              <VBox fx:id="cardDetailsPane" spacing="12.0">
                                 <children>
                                    <VBox spacing="4.0">
                                       <Label text="Cardholder Name" styleClass="field-label"/>
                                       <TextField fx:id="cardholderField" promptText="Name on card"
                                                  prefWidth="460.0"/>
                                    </VBox>
                                    <VBox spacing="4.0">
                                       <Label text="Card Number" styleClass="field-label"/>
                                       <TextField fx:id="cardNumberField"
                                                  promptText="1234  5678  9012  3456" prefWidth="460.0"/>
                                    </VBox>
                                    <HBox spacing="16.0">
                                       <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                                          <Label text="Expiry  (MM/YY)" styleClass="field-label"/>
                                          <TextField fx:id="expiryField" promptText="MM/YY" prefWidth="180.0"/>
                                       </VBox>
                                       <VBox spacing="4.0">
                                          <Label text="CVV" styleClass="field-label"/>
                                          <TextField fx:id="cvvField" promptText="123" prefWidth="110.0"/>
                                       </VBox>
                                    </HBox>
                                 </children>
                              </VBox>

                              <HBox spacing="12.0" style="-fx-padding: 4 0 0 0;">
                                 <Button fx:id="payButton" text="Pay Now"
                                         onAction="#processPayment"
                                         styleClass="btn-success" prefWidth="170.0" prefHeight="42.0"/>
                                 <Button text="Cancel &amp; Go Back" onAction="#goBack"
                                         styleClass="btn-danger" prefWidth="180.0" prefHeight="42.0"/>
                              </HBox>
                           </children>
                        </VBox>

                     </children>
                  </VBox>
               </children>
            </VBox>

         </children>
      </VBox>
   </children>
</AnchorPane>
