<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane stylesheets="@styles.css" prefHeight="720.0" prefWidth="1080.0"
            style="-fx-background-color: #F5F4F0;"
            xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.btm495.miyamoto.controllers.ManageAvailabilityController">
   <children>
      <VBox AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0"
            AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">
         <children>

            <!-- Topbar -->
            <HBox styleClass="topbar" prefHeight="66.0" alignment="CENTER_LEFT">
               <Region styleClass="topbar-accent" prefHeight="66.0"/>
               <VBox style="-fx-padding: 0 0 0 18;">
                  <Label styleClass="topbar-title" text="Manage Availability"/>
                  <Label styleClass="topbar-subtitle" text="Miyamoto Sushi Academy — Employee Portal"/>
               </VBox>
            </HBox>

            <!-- Body -->
            <HBox VBox.vgrow="ALWAYS" spacing="16.0" style="-fx-padding: 18 18 18 18;">
               <children>

                  <!-- ── LEFT: Table + Actions ─────────────── -->
                  <VBox spacing="12.0" HBox.hgrow="ALWAYS">
                     <children>

                        <TableView fx:id="availabilityTable" VBox.vgrow="ALWAYS" prefHeight="530.0">
                           <columns>
                              <TableColumn fx:id="typeTableColumn"      text="Class Type"  prefWidth="145.0"/>
                              <TableColumn fx:id="startTimeTableColumn" text="Start"        prefWidth="145.0"/>
                              <TableColumn fx:id="endTimeTableColumn"   text="End Time"     prefWidth="82.0"/>
                              <TableColumn fx:id="priceTableColumn"     text="Price"        prefWidth="72.0"/>
                              <TableColumn fx:id="spotsTableColumn"     text="Spots"        prefWidth="56.0"/>
                              <TableColumn fx:id="activeTableColumn"    text="Status"       prefWidth="90.0"/>
                           </columns>
                           <placeholder>
                              <Label text="No classes added yet. Use the form to add one."
                                     styleClass="text-muted"/>
                           </placeholder>
                        </TableView>

                        <HBox spacing="8.0">
                           <Button text="Load Selected" onAction="#loadSelected"
                                   styleClass="btn-info btn-sm" prefHeight="34.0"/>
                           <Button fx:id="toggleStatusButton" text="Cancel"
                                   onAction="#toggleStatus"
                                   styleClass="btn-danger btn-sm" prefHeight="34.0"/>
                           <Button fx:id="filterToggleButton" text="Active / Upcoming"
                                   onAction="#toggleFilter"
                                   styleClass="btn-outline btn-sm" prefHeight="34.0"/>
                           <Button text="Refresh" onAction="#refreshTable"
                                   styleClass="btn-outline btn-sm" prefHeight="34.0"/>
                           <Region HBox.hgrow="ALWAYS"/>
                           <Button text="Back" onAction="#goBack"
                                   styleClass="btn-dark btn-sm" prefHeight="34.0"/>
                        </HBox>
                     </children>
                  </VBox>

                  <!-- ── RIGHT: Add / Edit Form ──────────── -->
                  <VBox spacing="0.0" prefWidth="390.0">
                     <children>
                        <VBox styleClass="card" spacing="0.0" style="-fx-padding: 0;">
                           <children>

                              <!-- Form header -->
                              <HBox style="-fx-background-color: #EDEAE4; -fx-background-radius: 12 12 0 0;
                                          -fx-padding: 14 18 14 18; -fx-border-color: transparent transparent #E2DDD7 transparent;
                                          -fx-border-width: 0 0 1 0;" alignment="CENTER_LEFT">
                                 <Label fx:id="formTitleLabel" text="Add New Class" styleClass="section-title"/>
                              </HBox>

                              <VBox spacing="10.0" style="-fx-padding: 16 18 18 18;">
                                 <children>

                                    <VBox spacing="4.0">
                                       <Label text="Class Type" styleClass="field-label"/>
                                       <TextField fx:id="classTypeField"
                                                  promptText="e.g. Beginner Sushi Rolling" prefWidth="354.0"/>
                                    </VBox>

                                    <VBox spacing="4.0">
                                       <Label text="Description" styleClass="field-label"/>
                                       <TextField fx:id="descriptionField"
                                                  promptText="Brief description" prefWidth="354.0"/>
                                    </VBox>

                                    <VBox spacing="4.0">
                                       <Label text="Date" styleClass="field-label"/>
                                       <DatePicker fx:id="startDatePicker" prefWidth="200.0"/>
                                    </VBox>

                                    <HBox spacing="12.0">
                                       <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                                          <Label text="Start Time  (HH:MM)" styleClass="field-label"/>
                                          <TextField fx:id="startTimeField" promptText="e.g. 10:00"
                                                     prefWidth="160.0"/>
                                       </VBox>
                                       <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                                          <Label text="End Time  (HH:MM)" styleClass="field-label"/>
                                          <TextField fx:id="endTimeField" promptText="e.g. 12:00"
                                                     prefWidth="160.0"/>
                                       </VBox>
                                    </HBox>

                                    <HBox spacing="12.0">
                                       <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                                          <Label text="Duration" styleClass="field-label"/>
                                          <TextField fx:id="durationField" promptText="e.g. 2 hours"
                                                     prefWidth="130.0"/>
                                       </VBox>
                                       <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                                          <Label text="Price ($)" styleClass="field-label"/>
                                          <TextField fx:id="basePriceField" promptText="e.g. 75.00"
                                                     prefWidth="100.0"/>
                                       </VBox>
                                       <VBox spacing="4.0">
                                          <Label text="Max Spots" styleClass="field-label"/>
                                          <TextField fx:id="maxSpotsField" promptText="e.g. 10"
                                                     prefWidth="80.0"/>
                                       </VBox>
                                    </HBox>

                                    <VBox spacing="4.0">
                                       <Label text="Chef" styleClass="field-label"/>
                                       <TextField fx:id="defaultChefField" promptText="Chef name"
                                                  prefWidth="354.0"/>
                                    </VBox>

                                    <VBox spacing="4.0">
                                       <Label text="Materials / Ingredients" styleClass="field-label"/>
                                       <TextField fx:id="materialsField"
                                                  promptText="e.g. Rice, nori, salmon, soy sauce"
                                                  prefWidth="354.0"/>
                                    </VBox>

                                    <VBox spacing="4.0">
                                       <Label text="Address" styleClass="field-label"/>
                                       <TextField fx:id="addressField"
                                                  promptText="Class location address"
                                                  prefWidth="354.0"/>
                                    </VBox>

                                    <HBox spacing="10.0" style="-fx-padding: 6 0 0 0;">
                                       <Button fx:id="saveButton" text="Save Class"
                                               onAction="#saveAvailability"
                                               styleClass="btn-accent" prefWidth="150.0" prefHeight="38.0"/>
                                       <Button text="Clear" onAction="#clearForm"
                                               styleClass="btn-outline" prefWidth="96.0" prefHeight="38.0"/>
                                    </HBox>

                                 </children>
                              </VBox>

                           </children>
                        </VBox>
                     </children>
                  </VBox>

               </children>
            </HBox>

         </children>
      </VBox>
   </children>
</AnchorPane>
